  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "migrate:create": "node-pg-migrate --migrations-dir src/db/migrations create",
    "migrate:up": "node-pg-migrate --migrations-dir src/db/migrations up",
    "migrate:down": "node-pg-migrate --migrations-dir src/db/migrations down"
